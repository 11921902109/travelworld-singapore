# Copy to .dev.vars for the local Cloudflare Worker. Fill in your own values.
# Keep the filled file local and configure hosted credentials as secrets.

# Alibaba Cloud Bailian Managed Agent (server only)
DASHSCOPE_API_KEY=
# https://{workspace-id}.cn-beijing.maas.aliyuncs.com/api/v1/agentstudio
BAILIAN_API_BASE_URL=
BAILIAN_AGENT_ID=
BAILIAN_ENVIRONMENT_ID=

# Optional server-only FlyAI credential for the agent's FlyAI Skill.
FLYAI_API_KEY=

# Google Maps Platform. Restrict the server key to Places API (New) and Routes API.
GOOGLE_MAPS_SERVER_KEY=
# Delivered to the browser. Restrict by allowed HTTP referrers and Maps JavaScript API.
GOOGLE_MAPS_BROWSER_KEY=

# Optional direct Qwen fallback. DASHSCOPE_API_KEY can be reused by this path.
QWEN_API_KEY=
QWEN_API_URL=
QWEN_MODEL=
