# Copy this file to .env.local and fill in your own values.
# Never commit real API keys or production credentials.

# Alibaba Cloud Bailian / Qwen (server only)
# DASHSCOPE_API_KEY is used by both the Managed Agent and direct-Qwen fallback.
DASHSCOPE_API_KEY=
# Format:
# https://{workspace_id}.cn-beijing.maas.aliyuncs.com/api/v1/agentstudio
BAILIAN_API_BASE_URL=
BAILIAN_AGENT_ID=
BAILIAN_ENVIRONMENT_ID=

# FlyAI / Fliggy commerce lookup (server only)
FLYAI_API_KEY=

# Google Maps Platform
GOOGLE_MAPS_SERVER_KEY=
# This key is delivered to the browser. Restrict it by HTTP referrer and API.
GOOGLE_MAPS_BROWSER_KEY=

# Optional Qwen compatibility settings. QWEN_API_KEY is a fallback name only.
QWEN_API_KEY=
QWEN_API_URL=
QWEN_MODEL=qwen3.8-flash
